# MyPlayer Service Configuration
# Скопируйте этот файл в .env и отредактируйте под вашу систему

# Порт сервиса (по умолчанию 7788)
# MYPLAYER_PORT=7788

# Пути к ffmpeg и ffprobe
# MYPLAYER_FFMPEG=/home/root/bin/ffmpeg
# MYPLAYER_FFPROBE=/home/root/bin/ffprobe

# Корневые директории для доступа к файлам (разделитель :)
# Проверьте реальные точки монтирования: mount | grep -i usb
# MYPLAYER_ROOTS=/tmp/usb:/media

# Максимальная ширина видео при транскодировании (99999 = без ограничения)
# MYPLAYER_MAX_WIDTH=99999

# Принудительно перекодировать 10-бит в 8-бит (true/false)
# MYPLAYER_FORCE_REENCODE=false
